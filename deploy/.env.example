COMPOSE_PROJECT_NAME=fnord-dedup
FNORD_BIND_ADDRESS=127.0.0.1
FNORD_PORT=8088
FNORD_OPERATOR_USERNAME=operator
FNORD_SECURE_COOKIES=false
# Off by default. true trades PostgreSQL crash durability for much lower write latency.
FNORD_POSTGRES_DISPOSABLE=false
# Used only with compose.sources.yaml; replace with an existing host directory.
FNORD_SOURCE_ARCHIVE=/absolute/existing/archive
