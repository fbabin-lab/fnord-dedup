{
  "name": "fnord-dedup-ui", "version": "0.1.0", "private": true,
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "api:generate": "npm --prefix ../tools/api-codegen ci --no-audit --no-fund && npm --prefix ../tools/api-codegen run generate",
    "api:check": "npm run api:generate && git diff --exit-code -- src/app/api-schema.ts"
  },
  "dependencies": {
    "@angular/animations": "22.0.7", "@angular/cdk": "22.0.7",
    "@angular/common": "22.0.7", "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7", "@angular/forms": "22.0.7",
    "@angular/material": "22.0.7", "@angular/platform-browser": "22.0.7",
    "@angular/router": "22.0.7", "rxjs": "7.8.2", "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.7", "@angular/cli": "22.0.7", "@angular/compiler-cli": "22.0.7",
    "@playwright/test": "1.63.0", "typescript": "6.0.3", "vitest": "4.0.18",
    "jsdom": "28.1.0"
  }
}
