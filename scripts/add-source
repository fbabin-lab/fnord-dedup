#!/usr/bin/env python3
"""Safely register one read-only scan source in the private Fnord Dedup config."""
from __future__ import annotations

import argparse
import os
from pathlib import Path
import re
import sys
import tempfile
import uuid

KEY_RE = re.compile(r"[a-z0-9][a-z0-9_-]{0,63}$")
ENV_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


def fail(message: str) -> "NoReturn":
    raise SystemExit(f"add-source: {message}")


def default_key(path: Path) -> str:
    value = re.sub(r"[^a-z0-9_-]+", "-", path.name.lower()).strip("-_")
    if not value or not value[0].isalnum():
        fail("could not derive a source key from the directory name; pass --key")
    return value[:64]


def default_label(key: str) -> str:
    return " ".join(part.capitalize() for part in re.split(r"[-_]+", key) if part)


def env_token(key: str) -> str:
    return re.sub(r"[^A-Za-z0-9]", "_", key).upper()


def env_value(value: str) -> str:
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
        fail("host directory contains a control character that cannot be stored safely in deploy/.env")
    if re.fullmatch(r"[A-Za-z0-9_./:@%+,=-]+", value):
        return value
    # Compose supports double-quoted .env values. Prevent interpolation of literal '$'.
    escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("$", "$$")
    return f'"{escaped}"'


def split_lines(text: str) -> list[str]:
    return text.splitlines(keepends=True)


def ensure_nl(line: str) -> str:
    return line if line.endswith("\n") else line + "\n"


def leading_spaces(line: str) -> int:
    return len(line) - len(line.lstrip(" "))


def find_line(lines: list[str], text: str, indent: int, start: int = 0, end: int | None = None) -> int | None:
    if end is None:
        end = len(lines)
    expected = " " * indent + text
    for i in range(start, end):
        if lines[i].rstrip("\r\n") == expected:
            return i
    return None




def find_yaml_key(lines: list[str], key: str, indent: int, start: int = 0, end: int | None = None) -> int | None:
    if end is None:
        end = len(lines)
    prefix = " " * indent + key + ":"
    for i in range(start, end):
        raw = lines[i].rstrip("\r\n")
        if raw.startswith(prefix):
            if raw != prefix:
                fail(f"YAML key {key!r} must use block style for add-source to manage it safely")
            return i
    return None

def block_end(lines: list[str], start: int, indent: int) -> int:
    """End of a YAML mapping/list value whose key is at *indent*."""
    i = start + 1
    while i < len(lines):
        raw = lines[i].rstrip("\r\n")
        stripped = raw.strip()
        if stripped and not stripped.startswith("#") and leading_spaces(raw) <= indent:
            break
        i += 1
    return i


def parse_env(text: str) -> dict[str, str]:
    result: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or not ENV_RE.match(line):
            continue
        name, value = line.split("=", 1)
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
            if raw.strip().split("=", 1)[1].strip().startswith('"'):
                value = value.replace("$$", "$").replace('\\"', '"').replace("\\\\", "\\")
        result[name] = value
    return result


def update_env(text: str, variable: str, host_path: str) -> tuple[str, bool]:
    current = parse_env(text)
    if variable in current:
        if current[variable] != host_path:
            fail(f"{variable} already points to {current[variable]!r}, not {host_path!r}")
        return text, False
    suffix = "" if not text or text.endswith("\n") else "\n"
    return text + suffix + f"{variable}={env_value(host_path)}\n", True


def source_blocks(lines: list[str], sources_index: int, sources_end: int) -> list[tuple[int, int, dict[str, str]]]:
    starts: list[int] = []
    for i in range(sources_index + 1, sources_end):
        raw = lines[i].rstrip("\r\n")
        if raw.startswith("    - "):
            starts.append(i)
    blocks: list[tuple[int, int, dict[str, str]]] = []
    for pos, start in enumerate(starts):
        end = starts[pos + 1] if pos + 1 < len(starts) else sources_end
