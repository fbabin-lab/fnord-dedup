#!/usr/bin/env python3
"""Inspect configuration and source existence; never write a source probe."""
import json
import os
from pathlib import Path
import platform
import subprocess
import sys

repo = Path(__file__).resolve().parent.parent
if platform.system() != 'Linux' or platform.machine() != 'x86_64':
    sys.exit('Source access requires Linux/amd64.')
subprocess.run(['docker', 'version'], check=True, stdout=subprocess.DEVNULL)
subprocess.run(['docker', 'compose', 'version'], check=True)
config = json.loads(subprocess.check_output([str(repo/'scripts/fnord'), 'config', '--format', 'json']))
for name in ['database-password', 'operator-password-hash']:
    if not (repo/'deploy/secrets'/name).is_file():
        sys.exit('Missing credentials. Run ./scripts/setup first.')
sources = 0
for mount in config['services']['backend'].get('volumes', []):
    if mount['type'] != 'bind' or not mount['target'].startswith('/sources/'):
        continue
    sources += 1
    if not mount.get('read_only') or mount.get('bind', {}).get('create_host_path', True):
        sys.exit('Source binds require read_only=true and create_host_path=false.')
    path = Path(mount['source'])
    if not path.is_absolute() or not path.is_dir():
        sys.exit('A source host directory is missing or is not absolute.')
    if not os.access(path, os.R_OK | os.X_OK):
        sys.exit('The current host user cannot inspect a configured source directory.')
print(f'Preflight passed; {sources} configured source bind(s).')
print('The backend will validate effective mounts and access as its runtime UID at startup.')
